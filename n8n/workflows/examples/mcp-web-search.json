      "id": "2",
      "name": "HTTP Request - MCP Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse SSE response from MCP server\nconst responseData = $input.item.json.body;\n\n// Extract data from SSE format\nconst lines = responseData.split('\\n');\nconst dataLine = lines.find(line => line.startsWith('data: '));\n\nif (!dataLine) {\n  throw new Error('No SSE data line found in response');\n}\n\n// Parse JSON from data line\nconst jsonData = JSON.parse(dataLine.substring(6));\n\n// Extract search results\nif (jsonData.result && jsonData.result.content && jsonData.result.content.length > 0) {\n  const textContent = jsonData.result.content[0].text;\n  const searchResults = JSON.parse(textContent);\n  \n  return searchResults.map((result, index) => ({\n    json: {\n      position: index + 1,
      title: result.title,
      url: result.url,
      snippet: result.snippet
    }\n  }));\n}\n\nreturn [];"
      },
      "id": "3",
      "name": "Parse SSE Response",
