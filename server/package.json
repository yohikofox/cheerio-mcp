{
  "name": "web-search-mcp",
  "version": "1.0.0",
  "description": "MCP server for web search and content extraction",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/server-http.js",
    "start:mcp": "node dist/server-mcp-http.js",
    "start:mcp-sdk": "node dist/server-mcp-sdk.js",
    "start:mcp-stateless": "node dist/server-mcp-stateless.js",
    "start:mcp-stateful": "node dist/server-mcp-stateful.js",
    "start:oauth-server": "node dist/oauth/oauth-server.js",
    "test:oauth": "./test-oauth-flow.sh",
    "test:no-auth": "./test-mcp-no-auth.sh"
  },
  "keywords": [
    "mcp",
    "search",
    "scraping",
    "cheerio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "cheerio": "^1.0.0",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "playwright-core": "^1.48.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "playwright": "^1.56.1",
    "typescript": "^5.7.2"
  }
}
