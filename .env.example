# MCP API Authentication
# Generate a secure key with: docker run --rm node:20-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Multiple keys can be comma-separated: key1,key2,key3
# Leave empty to disable authentication (not recommended for production)
MCP_API_KEYS=

# Example with authentication enabled:
# MCP_API_KEYS=abc123def456,xyz789ghi012
